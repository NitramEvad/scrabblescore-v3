# Base URL of the PHP API. Defaults to "/api" (same-origin) when unset, which is
# correct for the production deployment where the frontend and API share the
# domain scrabblescore.tookay.net. Only override for local dev or a split origin.
# VITE_API_BASE_URL=/api

# Optional: enables AI-generated victory poems / slow-turn quips. Without it the
# app falls back to built-in canned lines.
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here
